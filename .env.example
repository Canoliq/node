# ---- required -------------------------------------------------------------
# Public domain for this deployment. Use "localhost" for local development
# Production: point a *.<DOMAIN> wildcard to the server's IP.
DOMAIN=localhost

# Docker network of a chain-1 node running on THIS machine, used only with
# docker-compose.rootchain-local.yml (make node-up-local-rootchain). The default
# suits `git clone https://github.com/canopy-network/node` run as-is;
# `docker network ls` shows the real name if you cloned into another folder.
ROOT_CHAIN_NETWORK=node_default

# Basic-auth for the wallet, admin RPC and Grafana (monitoring.<DOMAIN>).
# ONLY read when you start the monitoring stack (make up); the plain node
# ignores them. There is NO default: `make up` refuses to start until both
# AUTH_PASSWORDHASH and GF_ADMIN_PASSWORD are set, and every start refuses the
# old published example values.
#
# Generate the hash with:
#   make hash-password
# (prompts for a password and prints an already-escaped line, ready to paste)
#
# If generating manually instead, escape every $ as $$ and use the same caddy
# version as docker-compose.monitoring.yml:
#   docker run --rm -it caddy:2.11.7-alpine caddy hash-password
AUTH_USER=canopy
AUTH_PASSWORDHASH=

# Grafana admin login (behind the basic-auth above). Use a strong, unique
# password. Grafana applies it only on first start; see README "Monitoring".
GF_ADMIN_USER=canopy
GF_ADMIN_PASSWORD=

# (Optional) External alert routing notifications
ALERTS_DISCORD_WEBHOOK=
ALERTS_PAGERDUTY_ROUTING_KEY=

# (Optional) Public canoLiq snapshot for `make snapshot`.
# This MUST be chain 29's snapshot -- the generic canopy-1 URL is the ROOT
# chain's data and would restore the wrong chain into this node.
SNAPSHOT_URL=https://public-snapshots.app.canopynetwork.org/chain/29
# (Optional) Expected sha256 of the snapshot archive. If unset, the script tries
# <SNAPSHOT_URL>.sha256; with neither, it warns that the download is unverified.
SNAPSHOT_SHA256=

# (Optional) Pin the node image instead of following :latest, e.g.
#   CANOLIQ_NODE_IMAGE=canopynetwork/canopy-plugin-go@sha256:<digest>
# See README "Updates" before changing this.
CANOLIQ_NODE_IMAGE=
